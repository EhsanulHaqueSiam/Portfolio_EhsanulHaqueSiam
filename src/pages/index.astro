---
import Layout from '../layouts/Layout.astro';
import App from '../App';
import { loadOpenSource } from '../data/opensource';

// Stars and PR states are refreshed from GitHub on every build (JSON fallback).
const openSource = await loadOpenSource();
---

<Layout>
  {/* One React island: Astro server-renders it to static HTML at build (SEO/AEO/GEO),
      then client:load hydrates it for sounds, the dock, the pile and the overlays. */}
  <App client:load page="home" openSource={openSource} />
</Layout>
