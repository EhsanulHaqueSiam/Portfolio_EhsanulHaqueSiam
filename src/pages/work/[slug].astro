---
import Layout from '../../layouts/Layout.astro';
import App from '../../App';
import { featuredExperience, workSlug } from '../../data/content';
import { SITE } from '../../seo/schema';

export function getStaticPaths() {
  return featuredExperience.map((e) => ({ params: { slug: workSlug(e) }, props: { slug: workSlug(e), company: e.company, role: e.role } }));
}
const { slug, company, role } = Astro.props;
---

<Layout title={`${role} at ${company} · Ehsanul Haque Siam`} description={`What Ehsanul Haque Siam did as ${role} at ${company}.`} canonical={`${SITE.url}/work/${slug}`}>
  <App client:load page="work" slug={slug} />
</Layout>
