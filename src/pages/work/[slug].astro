---
import Layout from '../../layouts/Layout.astro';
import App from '../../App';
import { featuredExperience, workSlug } from '../../data/content';
import { SITE, pageJsonLd } from '../../seo/schema';

export function getStaticPaths() {
  return featuredExperience.map((e) => ({ params: { slug: workSlug(e) }, props: { slug: workSlug(e), company: e.company, role: e.role } }));
}
const { slug, company, role } = Astro.props;
const path = `/work/${slug}/`;
const title = `${role} at ${company} · Ehsanul Haque Siam`;
const description = `What Ehsanul Haque Siam did as ${role} at ${company}.`;
const jsonLd = pageJsonLd({ path, name: title, description, crumbs: [['Work', '/#experience'], [company, path]] });
---

<Layout title={title} description={description} canonical={`${SITE.url}${path}`} jsonLd={jsonLd}>
  <App client:load page="work" slug={slug} />
</Layout>
