---
import Layout from '../../layouts/Layout.astro';
import App from '../../App';
import { featuredExperience, workSlug } from '../../data/content';
import { SITE, metaDescription, pageJsonLd, plainRole } from '../../seo/schema';

export function getStaticPaths() {
  return featuredExperience.map((e) => ({ params: { slug: workSlug(e) }, props: { slug: workSlug(e), company: e.company, role: e.role, desc: e.desc } }));
}
const { slug, company, role, desc } = Astro.props;
const path = `/work/${slug}/`;
const title = `${plainRole(role)} at ${company} · Ehsanul Haque Siam`;
const description = metaDescription(desc);
const jsonLd = pageJsonLd({ path, name: title, description, crumbs: [[company, path]] });
---

<Layout title={title} description={description} canonical={`${SITE.url}${path}`} jsonLd={jsonLd}>
  <App client:load page="work" slug={slug} />
</Layout>
