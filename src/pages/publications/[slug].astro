---
import Layout from '../../layouts/Layout.astro';
import App from '../../App';
import { loadPapers } from '../../data/papers';
import { SITE } from '../../seo/schema';

// Authors, venue and BibTeX come from the DOI registry at build time (see data/papers.ts).
export async function getStaticPaths() {
  const papers = await loadPapers();
  return papers.map((paper) => ({ params: { slug: paper.slug }, props: { paper } }));
}
const { paper } = Astro.props;
---

<Layout ogType="article" title={`${paper.pub.title} · Ehsanul Haque Siam`} description={paper.pub.desc.length > 155 ? `${paper.pub.desc.slice(0, 154).replace(/\s+\S*$/, '')}…` : paper.pub.desc} canonical={`${SITE.url}/publications/${paper.slug}/`}>
  <App client:load page="paper" paper={paper} />
</Layout>
