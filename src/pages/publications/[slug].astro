---
import Layout from '../../layouts/Layout.astro';
import App from '../../App';
import { loadPapers } from '../../data/papers';
import { SITE, metaDescription, pageJsonLd, paperJsonLd } from '../../seo/schema';

// Authors, venue and BibTeX come from the DOI registry at build time (see data/papers.ts).
export async function getStaticPaths() {
  const papers = await loadPapers();
  return papers.map((paper) => ({ params: { slug: paper.slug }, props: { paper } }));
}
const { paper } = Astro.props;
const path = `/publications/${paper.slug}/`;
const title = `${paper.pub.title} · Ehsanul Haque Siam`;
const description = metaDescription(paper.pub.desc);
const jsonLd = pageJsonLd({
  path,
  name: title,
  description,
  crumbs: [['Publications', '/publications/'], [paper.pub.title.split(':')[0], path]],
  main: paperJsonLd(paper),
});
---

<Layout ogType="article" title={title} description={description} canonical={`${SITE.url}${path}`} jsonLd={jsonLd}>
  <App client:load page="paper" paper={paper} />
</Layout>
